APP_NAME="Palapa La Casona"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://tudominio.com

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=casona_db
DB_USERNAME=root
DB_PASSWORD=

# Cola de trabajo — cambiar a "database" o "redis" en producción
# Con "sync" los correos se mandan de forma síncrona (bloquea la respuesta)
QUEUE_CONNECTION=database

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# Orígenes permitidos para CORS (separados por coma)
# Ejemplo: https://tudominio.com,https://www.tudominio.com
CORS_ALLOWED_ORIGINS=*

# Frontend — Variables expuestas al JS (prefijo VITE_ obligatorio)
VITE_WHATSAPP_NUMBER=521XXXXXXXXXX
VITE_BANK_CLABE=000000000000000000
VITE_BANK_TITULAR="Palapa La Casona"

# Datos del establecimiento para contratos PDF
CASONA_ESTABLISHMENT="Palapa \"La Casona\""
CASONA_REPRESENTATIVE="María Magdalena Cruz García"
CASONA_CITY="San Pedro Pochutla, Oaxaca"

SESSION_DRIVER=database
SESSION_LIFETIME=120

CACHE_STORE=database